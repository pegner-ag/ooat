    "body_workspace_used": {"type": "object", "required": ["project", "by", "write", "read", "changed", "created", "refused", "operations", "written_bytes", "limit", "journal_lines"], "additionalProperties": false, "properties": {"project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "by": {"enum": ["worker", "critic", "reception"]}, "conversation": {"description": "The conversation of a direct answer (ADR 0018); such an event has task: null.", "$ref": "common.schema.json#/$defs/conversation_id"}, "write": {"type": "boolean"}, "read": {"type": "array", "items": {"type": "object", "required": ["path", "times"], "additionalProperties": false, "properties": {"path": {"$ref": "#/$defs/workspace_path"}, "times": {"type": "integer", "minimum": 1}}}}, "changed": {"type": "array", "items": {"type": "object", "required": ["path", "before", "after", "added", "removed"], "additionalProperties": false, "properties": {"path": {"$ref": "#/$defs/workspace_path"}, "before": {"$ref": "#/$defs/content_hash"}, "after": {"$ref": "#/$defs/content_hash"}, "added": {"$ref": "#/$defs/count"}, "removed": {"$ref": "#/$defs/count"}, "original": {"$ref": "common.schema.json#/$defs/artifact_ref"}, "interrupted": {"description": "Someone else wrote the file between two of the task's writes: revert skips it.", "type": "boolean"}}}}, "created": {"type": "array", "items": {"type": "object", "required": ["path", "after", "added"], "additionalProperties": false, "properties": {"path": {"$ref": "#/$defs/workspace_path"}, "after": {"$ref": "#/$defs/content_hash"}, "added": {"$ref": "#/$defs/count"}}}}, "refused": {"type": "array", "items": {"type": "object", "required": ["path", "tool", "reason"], "additionalProperties": false, "properties": {"path": {"$ref": "#/$defs/workspace_path"}, "tool": {"type": "string", "maxLength": 40}, "reason": {"type": "string", "maxLength": 200}}}}, "operations": {"description": "Operations of this role in the task so far (a total, not per event).", "$ref": "#/$defs/count"}, "written_bytes": {"description": "Bytes this role wrote in the task so far (a total).", "$ref": "#/$defs/count"}, "limit": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["kind", "operation", "tool", "path"], "additionalProperties": false, "properties": {"kind": {"enum": ["operations", "write_bytes"]}, "operation": {"$ref": "#/$defs/count"}, "tool": {"type": "string", "maxLength": 40}, "path": {"$ref": "#/$defs/workspace_path"}}}]}, "journal_lines": {"description": "Journal lines covered so far (a total); the next event starts after them.", "$ref": "#/$defs/count"}, "diff": {"description": "A unified diff of the task's changes so far (artifact kind workspace_diff).", "$ref": "common.schema.json#/$defs/artifact_ref"}}, "description": "What the calls of one role (worker, critic, or the reception's direct answer) did on a project's folders since the last such event, from OOAT's journal: paths, hashes and counts, never contents (ADR 0017)."},
    "body_workspace_reverted": {"type": "object", "required": ["project", "restored", "skipped", "kept"], "additionalProperties": false, "properties": {"project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "restored": {"type": "array", "items": {"type": "object", "required": ["path", "after"], "additionalProperties": false, "properties": {"path": {"$ref": "#/$defs/workspace_path"}, "after": {"$ref": "#/$defs/content_hash"}}}}, "skipped": {"type": "array", "items": {"type": "object", "required": ["path", "reason"], "additionalProperties": false, "properties": {"path": {"$ref": "#/$defs/workspace_path"}, "reason": {"type": "string", "maxLength": 200}}}}, "kept": {"type": "array", "items": {"$ref": "#/$defs/workspace_path"}}, "channel": {"$ref": "#/$defs/channel"}}, "description": "The operator's revert of a task's changes: originals written back where the file is unchanged since; created files are never deleted (ADR 0017)."},
