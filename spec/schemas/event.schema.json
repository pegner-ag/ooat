    "body_conversation_message": {"description": "A person's message or tap in a conversation (ADR 0018); the text stays in the ledger like a task's goal.", "type": "object", "required": ["conversation", "project", "channel", "data_class"], "additionalProperties": false, "properties": {"conversation": {"$ref": "common.schema.json#/$defs/conversation_id"}, "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "channel": {"$ref": "#/$defs/channel"}, "text": {"$ref": "#/$defs/text"}, "tap": {"$ref": "#/$defs/tap"}, "tap_text": {"description": "The text given with a tap, e.g. a correction after Differently.", "$ref": "#/$defs/text"}, "reply_to": {"$ref": "common.schema.json#/$defs/event_id"}, "intake_key": {"description": "The client's idempotency key; unique per channel, checked by the ledger (ADR 0016).", "type": "string", "pattern": "^[!-~]{1,128}$"}, "attachment_names": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^(?!\\.{1,2}$)[^/\\:]+$"}}, "data_class": {"$ref": "common.schema.json#/$defs/data_class"}}, "oneOf": [{"required": ["text"], "not": {"required": ["tap"]}}, {"required": ["tap"], "not": {"required": ["text"]}}]},
    "body_reception_decided": {"description": "The reception's decision on one or more messages, the reply it sent and what it did (ADR 0018). Prompts are never stored, only the ids of the context items used.", "type": "object", "required": ["conversation", "project", "messages", "decision", "options", "buttons", "context", "data_class"], "additionalProperties": false, "properties": {"conversation": {"$ref": "common.schema.json#/$defs/conversation_id"}, "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "messages": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/event_id"}, "uniqueItems": true}, "decision": {"enum": ["answer", "task", "confirm", "ask", "continue_task", "status", "cancel", "command", "switch", "forget", "escalated", "retried"], "description": "escalated and retried: a call whose decision was replaced by the next call, on the workhorse tier or after an unusable reply; they carry that call's cost."}, "reply": {"type": "string", "minLength": 1, "maxLength": 20000}, "interpretation": {"type": "string", "minLength": 1, "maxLength": 1000}, "options": {"description": "Numbered next steps the person may answer by number (design 08 §4 rule 8).", "type": "array", "maxItems": 9, "items": {"type": "string", "minLength": 1, "maxLength": 300}}, "buttons": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/tap"}, "uniqueItems": true}, "task": {"description": "The task started, answered, continued or cancelled.", "$ref": "common.schema.json#/$defs/task_id"}, "cancelled": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/task_id"}}, "switch_to": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "memory": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/memory_id"}}, "pending": {"description": "What a Yes tap starts after a confirm.", "type": "object", "required": ["goal"], "additionalProperties": false, "properties": {"goal": {"$ref": "#/$defs/text"}, "acceptance": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "risk_class": {"$ref": "common.schema.json#/$defs/risk_class"}, "follows": {"$ref": "common.schema.json#/$defs/task_id"}}}, "record": {"description": "Who decided and how sure, for the reception's threshold (ADR 0011).", "type": "object", "required": ["engine", "model", "confidence", "threshold"], "additionalProperties": false, "properties": {"engine": {"$ref": "common.schema.json#/$defs/provider_id"}, "model": {"type": "string", "minLength": 1}, "confidence": {"$ref": "common.schema.json#/$defs/probability"}, "threshold": {"$ref": "common.schema.json#/$defs/probability"}}}, "context": {"type": "array", "items": {"type": "string", "pattern": "^(evt|mem|tsk|cnv)_[0-7][0-9A-HJKMNP-TV-Z]{25}$"}}, "data_class": {"$ref": "common.schema.json#/$defs/data_class"}, "fallback": {"description": "The reception failed; the message went as a task.", "type": "boolean"}, "reading": {"description": "A direct answer that reads the project's files follows in the next decision.", "type": "boolean"}}},
    "body_conversation_reported": {"description": "The reception's report when a task started from the conversation closed: asked, how solved, state, next (ADR 0018).", "type": "object", "required": ["conversation", "project", "task", "reply", "options", "data_class"], "additionalProperties": false, "properties": {"conversation": {"$ref": "common.schema.json#/$defs/conversation_id"}, "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "task": {"$ref": "common.schema.json#/$defs/task_id"}, "reply": {"type": "string", "minLength": 1, "maxLength": 20000}, "options": {"description": "Numbered next steps the person may answer by number (design 08 §4 rule 8).", "type": "array", "maxItems": 9, "items": {"type": "string", "minLength": 1, "maxLength": 300}}, "data_class": {"$ref": "common.schema.json#/$defs/data_class"}}},
    "body_conversation_closed": {"type": "object", "required": ["conversation", "project", "reason"], "additionalProperties": false, "properties": {"conversation": {"$ref": "common.schema.json#/$defs/conversation_id"}, "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "reason": {"enum": ["silence", "new_conversation", "switched", "operator"]}, "summary": {"$ref": "common.schema.json#/$defs/memory_id"}}},
    "body_memory_noted": {"description": "A memory item was noted; its text is in the memory store, never here (ADR 0018).", "type": "object", "required": ["memory", "scope", "kind", "data_class", "source", "sha256"], "additionalProperties": false, "properties": {"memory": {"$ref": "common.schema.json#/$defs/memory_id"}, "scope": {"description": "A project slug, or operator for the operator's preferences.", "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "kind": {"enum": ["preference", "fact", "glossary", "summary", "todo"]}, "data_class": {"$ref": "common.schema.json#/$defs/data_class"}, "source": {"anyOf": [{"$ref": "common.schema.json#/$defs/event_id"}, {"$ref": "common.schema.json#/$defs/task_id"}]}, "sha256": {"$ref": "#/$defs/content_hash"}, "conversation": {"$ref": "common.schema.json#/$defs/conversation_id"}, "pinned": {"type": "boolean"}, "channel": {"$ref": "#/$defs/channel"}}},
