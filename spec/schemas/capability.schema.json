{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ooat.invalid/spec/v0.1/capability.schema.json",
  "title": "OOAT capability card",
  "description": "One typed operation with contract, acceptance, model policy and cost card (spec section 5).",
  "type": "object",
  "required": ["id", "version", "status", "summary", "impl", "input_schema", "output_schema", "acceptance", "cost_card", "eval_set"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/capability_id"},
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "status": {"$ref": "common.schema.json#/$defs/lifecycle_status"},
    "summary": {"description": "English one-line summary.", "type": "string", "minLength": 1, "maxLength": 200},
    "i18n": {
      "description": "Optional translations keyed by language tag.",
      "type": "object",
      "propertyNames": {"$ref": "common.schema.json#/$defs/lang"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"summary": {"type": "string", "minLength": 1, "maxLength": 200}}
      }
    },
    "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
    "impl": {"$ref": "common.schema.json#/$defs/impl"},
    "input_schema": {"description": "Path to the input JSON Schema.", "type": "string", "minLength": 1},
    "output_schema": {"description": "Path to the output JSON Schema.", "type": "string", "minLength": 1},
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/acceptance_criterion"}
    },
    "model_policy": {"$ref": "#/$defs/model_policy"},
    "tools": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true},
    "cost_card": {"$ref": "#/$defs/cost_card"},
    "abstain_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "eval_set": {"description": "Path to the capability's eval set.", "type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "description": "Model-backed capabilities need a model policy; deterministic ones must not have one.",
      "if": {"properties": {"impl": {"const": "deterministic"}}},
      "then": {"not": {"required": ["model_policy"]}},
      "else": {"required": ["model_policy"]}
    },
    {
      "description": "The decision tier serves only decision capabilities, and decision capabilities run on it.",
      "if": {"properties": {"impl": {"const": "decision"}}},
      "then": {"properties": {"model_policy": {"properties": {"tier": {"const": "decision"}}}}},
      "else": {"properties": {"model_policy": {"properties": {"tier": {"not": {"const": "decision"}}}}}}
    }
  ],
  "$defs": {
    "acceptance_criterion": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"enum": ["deterministic", "decision", "critic"]},
        "check": {"description": "jsonschema or script:<path>.", "type": "string", "pattern": "^(jsonschema|script:\\S+)$"},
        "capability": {"description": "The decision capability that checks this criterion.", "$ref": "common.schema.json#/$defs/capability_id"},
        "rubric": {"description": "Path to the critic rubric.", "type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "deterministic"}}}, "then": {"required": ["check"]}},
        {"if": {"properties": {"type": {"const": "decision"}}}, "then": {"required": ["capability"]}},
        {"if": {"properties": {"type": {"const": "critic"}}}, "then": {"required": ["rubric"]}}
      ]
    },
    "model_policy": {
      "type": "object",
      "required": ["tier", "max_attempts", "data_classes_allowed"],
      "additionalProperties": false,
      "properties": {
        "tier": {"$ref": "common.schema.json#/$defs/tier"},
        "escalate_to": {"$ref": "common.schema.json#/$defs/tier"},
        "escalate_when": {"description": "Condition, e.g. acceptance_failed >= 2.", "type": "string", "minLength": 1},
        "max_attempts": {"type": "integer", "minimum": 1},
        "data_classes_allowed": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/data_class"},
          "uniqueItems": true
        }
      },
      "dependentRequired": {"escalate_to": ["escalate_when"]}
    },
    "cost_card": {
      "type": "object",
      "required": ["prior", "observed"],
      "additionalProperties": false,
      "properties": {
        "prior": {
          "type": "object",
          "required": ["p_accept"],
          "additionalProperties": false,
          "properties": {
            "tokens_in_p50": {"type": "integer", "minimum": 0},
            "tokens_out_p50": {"type": "integer", "minimum": 0},
            "p_accept": {"$ref": "common.schema.json#/$defs/probability"}
          }
        },
        "observed": {
          "description": "Written only by ooat-core from the ledger; manual edits are rejected in CI.",
          "type": "object",
          "required": ["n"],
          "additionalProperties": false,
          "properties": {
            "n": {"type": "integer", "minimum": 0},
            "usd_p50": {"type": ["number", "null"], "minimum": 0},
            "usd_p90": {"type": ["number", "null"], "minimum": 0},
            "quota_units_p50": {"type": ["number", "null"], "minimum": 0},
            "p_accept": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "p_abstain": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "p_silent": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
          }
        }
      }
    }
  }
}
